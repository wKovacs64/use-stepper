{
  "name": "use-stepper",
  "version": "4.0.3",
  "private": false,
  "description": "React hook to manage a numeric stepper/spinbutton",
  "keywords": [
    "counter",
    "decrement",
    "hook",
    "hooks",
    "increment",
    "input",
    "react",
    "spinbutton",
    "stepper"
  ],
  "homepage": "https://github.com/wKovacs64/use-stepper#readme",
  "bugs": {
    "url": "https://github.com/wKovacs64/use-stepper/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wKovacs64/use-stepper.git"
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "type": "module",
  "main": "dist/use-stepper.cjs",
  "module": "dist/use-stepper.js",
  "exports": {
    "import": "./dist/use-stepper.js",
    "require": "./dist/use-stepper.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown ./src/use-stepper.ts --format cjs,esm --dts --sourcemap --clean",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install",
    "changeset:publish": "changeset publish",
    "clean": "rimraf dist coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepare": "pnpm run --silent build",
    "prepublishOnly": "run-s --silent lint typecheck test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc"
  },
  "dependencies": {},
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "@wkovacs64/oxlint-config": "0.1.0",
    "cross-env": "10.1.0",
    "doctoc": "2.5.0",
    "happy-dom": "20.11.2",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-test-renderer": "19.2.8",
    "rimraf": "6.1.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": ">= 16.8.0"
  },
  "packageManager": "pnpm@11.21.0"
}
